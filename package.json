{
  "name": "pleingaz-infotech",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "SMXKY",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "postinstall": "npx prisma generate",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build:compile": "npx prisma generate && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "ensure:dirs": "mkdirp dist/public dist/generated",
    "build:copy": "npm run ensure:dirs && cpy 'src/public/**' dist/public --parents && cpy 'src/generated/**' dist/generated --parents && copyfiles -V -u 1 'src/**/*.{hbs,ejs,html}' dist/",
    "build": "npx prisma generate && npx tsup src/index.ts --out-dir dist && cp -r src/public dist/ && cp -r src/generated dist/ && cp -r src/assets dist/ && cp -r src/locales dist/ && pm2 restart pleingaz-api",
    "build:prod": "NODE_ENV=production npm run build",
    "postbuild": "npm run build:verify",
    "build:verify": "node -e \"if (!require('fs').existsSync('./dist/public') && !require('fs').existsSync('./dist/generated')) { console.error('Build failed: dist directories not found'); process.exit(1); }\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^6.19.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.44.0",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.67.3",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csurf": "^1.11.0",
    "dotenv": "^17.2.4",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "ftp": "^0.3.10",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "otplib": "^13.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.18.0",
    "prisma": "^6.19.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ftp": "^0.3.36",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.2",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "copyfiles": "^2.4.1",
    "cpy-cli": "^7.0.0",
    "eslint": "^9.39.2",
    "mkdirp": "^3.0.1",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "_moduleAliases": {
    "@": "dist",
    "@controllers/*": [
      "src/controllers/*"
    ],
    "@services/*": [
      "src/services/*"
    ],
    "@routes/*": [
      "src/routes/*"
    ],
    "@middlewares/*": [
      "src/middlewares/*"
    ],
    "@models/*": [
      "src/models/*"
    ],
    "@utils/*": [
      "src/utils/*"
    ],
    "@cron-jobs/*": [
      "src/cron-jobs/*"
    ],
    "@defaults/*": [
      "src/defaults/*"
    ],
    "@public/*": [
      "src/public/*"
    ],
    "@appTypes/*": [
      "src/appTypes/*"
    ]
  }
}
