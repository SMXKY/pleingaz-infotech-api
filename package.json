{
  "name": "pleingaz-infotech",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "SMXKY",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "jest",
    "postinstall": "npx prisma generate",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build:compile": "npx prisma generate && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "ensure:dirs": "mkdirp dist/public dist/generated",
    "build:copy": "npm run ensure:dirs && cpy 'src/public/**' dist/public --parents && cpy 'src/generated/**' dist/generated --parents && copyfiles -V -u 1 'src/**/*.{hbs,ejs,html}' dist/",
    "build": "npx prisma generate && npx tsup src/index.ts --out-dir dist && cp -r src/public dist/ && cp -r src/generated dist/ && cp -r src/assets dist/ && cp -r src/locales dist/",
    "build:prod": "NODE_ENV=production npm run build",
    "postbuild": "npm run build:verify",
    "build:verify": "node -e \"if (!require('fs').existsSync('./dist/public') && !require('fs').existsSync('./dist/generated')) { console.error('Build failed: dist directories not found'); process.exit(1); }\"",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^6.19.2",
    "argon2": "^0.44.0",
    "axios": "^1.13.6",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.4",
    "express": "^5.1.0",
    "firebase-admin": "^13.7.0",
    "ftp": "^0.3.10",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "pg": "^8.18.0",
    "pg-boss": "^12.14.0",
    "prisma": "^6.19.2",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ftp": "^0.3.36",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.16.0",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "copyfiles": "^2.4.1",
    "cpy-cli": "^7.0.0",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "mkdirp": "^3.0.1",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "_moduleAliases": {
    "@": "dist",
    "@controllers/*": [
      "src/controllers/*"
    ],
    "@services/*": [
      "src/services/*"
    ],
    "@routes/*": [
      "src/routes/*"
    ],
    "@middlewares/*": [
      "src/middlewares/*"
    ],
    "@models/*": [
      "src/models/*"
    ],
    "@utils/*": [
      "src/utils/*"
    ],
    "@cron-jobs/*": [
      "src/cron-jobs/*"
    ],
    "@defaults/*": [
      "src/defaults/*"
    ],
    "@public/*": [
      "src/public/*"
    ],
    "@appTypes/*": [
      "src/appTypes/*"
    ]
  }
}
