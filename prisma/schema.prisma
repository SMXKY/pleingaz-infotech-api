  @@index([status])
  @@index([supplierId])
  @@index([paymentStatus])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("gas_bottle_purchase_orders")
}

model GasBottlePurchaseOrderItem {
  id           String                 @id @default(uuid())
  order        GasBottlePurchaseOrder @relation(fields: [orderId], references: [id])
  orderId      String                 @map("order_id")
