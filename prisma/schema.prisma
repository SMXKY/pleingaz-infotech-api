  itemId         String                 @map("item_id")
  quantity       Int
  unitPrice      Decimal                @map("unit_price") @db.Decimal(10, 4)
  lineTotal      Decimal                @map("line_total") @db.Decimal(15, 2)
  isHighPriority Boolean                @default(false) @map("is_high_priority")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([itemId])
  @@map("accessory_purchase_order_items")
}

model ExploitationInvoice {
  id            String                    @id @default(uuid())
  type          ExploitationInvoiceType
  refTable      String                    @map("ref_table")
  orderId       String                    @map("order_id")
  invoiceNumber String                    @map("invoice_number")
  invoiceDate   DateTime                  @map("invoice_date") @db.Date
  dueDate       DateTime?                 @map("due_date") @db.Date
  currency      Currency                  @default(XAF)
  vatPct        Decimal?                  @map("vat_pct") @db.Decimal(5, 2)
  vatAmount     Decimal?                  @map("vat_amount") @db.Decimal(15, 2)
  subTotal      Decimal?                  @map("sub_total") @db.Decimal(15, 2)
  total         Decimal                   @db.Decimal(15, 2)
  totalInCfa    Decimal?                  @map("total_in_cfa") @db.Decimal(15, 2)
  status        ExploitationInvoiceStatus @default(UNPAID)
  amountPaid    Decimal                   @default(0) @map("amount_paid") @db.Decimal(15, 2)
  paidAt        DateTime?                 @map("paid_at")
  notes         String?

  createdBy   User?   @relation("exploitation_invoices_created_by", fields: [createdById], references: [id])
  createdById String? @map("created_by_id")
  paidBy      User?   @relation("exploitation_invoices_paid_by", fields: [paidById], references: [id])
  paidById    String? @map("paid_by_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([invoiceNumber, type])
  @@index([type, orderId])
  @@index([status])
  @@index([deletedAt])
  @@map("exploitation_invoices")
}

model ExploitationDocument {
  id           String                   @id @default(uuid())
  refTable     String                   @map("ref_table")
  recordId     String                   @map("record_id")
  type         ExploitationDocumentType @default(OTHER)
  name         String
  url          String
  fileType     String?                  @map("file_type")
  sizeBytes    BigInt?                  @map("size_bytes")
  uploadedBy   User?                    @relation("exploitation_documents_uploaded_by", fields: [uploadedById], references: [id])
  uploadedById String?                  @map("uploaded_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // Hard deletes only — documents are never soft deleted

  @@index([refTable, recordId])
  @@index([type])
  @@index([uploadedById])
  @@map("exploitation_documents")
}

model Approval {
  id          String             @id @default(uuid())
  entityType  ApprovalEntityType @map("entity_type")
  refTable    String             @map("ref_table")
  recordId    String             @map("record_id")
  status      ApprovalStatus     @default(PENDING)
  currentStep Int                @default(1) @map("current_step")
  totalSteps  Int                @map("total_steps")
  requestedAt DateTime           @default(now()) @map("requested_at")
  completedAt DateTime?          @map("completed_at")

  requestedBy   User           @relation("approval_requested_by", fields: [requestedById], references: [id])
  requestedById String         @map("requested_by_id")
  steps         ApprovalStep[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entityType, recordId])
  @@index([status])
  @@index([requestedById])
  @@map("approvals")
}

model ApprovalStep {
  id          String         @id @default(uuid())
  approval    Approval       @relation(fields: [approvalId], references: [id])
  approvalId  String         @map("approval_id")
  step        Int
  role        ApprovalRole
  status      ApprovalStatus @default(PENDING)
  decidedAt   DateTime?      @map("decided_at")
  notes       String?
  decidedBy   User?          @relation("approval_step_decided_by", fields: [decidedById], references: [id])
  decidedById String?        @map("decided_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([approvalId, step])
  @@index([approvalId])
  @@index([status])
  @@map("approval_steps")
}

model ExchangeRate {
  id            String   @id @default(uuid())
  fromCurrency  Currency @map("from_currency")
  toCurrency    Currency @map("to_currency")
  rate          Decimal  @db.Decimal(15, 6)
  effectiveDate DateTime @map("effective_date") @db.Date
  source        String   @default("manual")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([fromCurrency, toCurrency, effectiveDate])
  @@index([effectiveDate(sort: Desc)])
  @@index([fromCurrency, toCurrency])
  @@map("exchange_rates")
}