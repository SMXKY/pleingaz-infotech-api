  logisticsNotes       String?       @map("logistics_notes")
  notes                String?
  internalNotes        String?       @map("internal_notes")
  emailSentAt          DateTime?     @map("email_sent_at")
  currency             Currency      @default(XAF)
  vatPct               Decimal       @map("vat_pct") @db.Decimal(5, 2)
  subTotal             Decimal?      @db.Decimal(15, 2)
  vatAmount            Decimal?      @map("vat_amount") @db.Decimal(15, 2)
  freightFees          Decimal?      @default(0) @map("freight_fees") @db.Decimal(15, 2)
  customsDuties        Decimal?      @default(0) @map("customs_duties") @db.Decimal(15, 2)
  insuranceAmount      Decimal?      @default(0) @map("insurance_amount") @db.Decimal(15, 2)
