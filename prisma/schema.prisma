datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

enum Status {
  ACTIVE
  TERMINATED
}

enum Gender {
  M
  F
}

enum Language {
  FR
  ENG
}

enum Currency {
  FCFA
  EUR
  USD
}

enum PermissionModule {
  EXPLOITATION
  LOGISTICS
  SALES
  FILLING_PRODUCTION
  ACCOUNTING
  HUMAN_RESOURCES
  LEGAL
  MAINTENANCE_TECHNICAL
  RESEARCH_DEVELOPMENT
  ADMIN
}

enum PermissionSubmodule {
  // EXPLOITATION
  GAS_ORDERS
  SUPPLIER_MANAGEMENT
  SAFETY_CAPS_JOINTS

  // LOGISTICS
  VEHICLE_INSPECTION
  FUEL_MANAGEMENT
  DRIVER_DOCUMENTS
  TRANSPORT_RECEIPTS
  POCKET_ALLOWANCE

  // SALES
  TRANSACTIONS
  WAREHOUSE_STOCK
  DISCOUNTS
  CASH_RECONCILIATION
  AGENCIES

  // FILLING_PRODUCTION
  TANK_MANAGEMENT
  BOTTLE_TRACKING
  PRODUCTION_RECORDS
  STOCK_RECONCILIATION

  // ACCOUNTING
  SUPPLIER_INVOICES
  CUSTOMER_INVOICES
  CASH_BANK
  PAYROLL
  FIXED_ASSETS
  TAX_DECLARATIONS
  FINANCIAL_REPORTS

  // HUMAN_RESOURCES
  ATTENDANCE
  RECRUITMENT
  SALARY_MANAGEMENT
  LEAVE_PERMISSION
  MISSIONS

  // LEGAL
  MAIL_MANAGEMENT
  INSURANCE
  ACCIDENTS
  DEBT_RECOVERY
  CONTRACTS
  COMPLAINTS
  CONVOCATIONS

  // MAINTENANCE_TECHNICAL
  FAULT_DECLARATION
  MAINTENANCE_WORKFLOW
  TECHNICIAN_ASSIGNMENT
  SPARE_PARTS
  MAINTENANCE_REPORTS

  // RESEARCH_DEVELOPMENT
  PROJECTS
  PROJECT_MONITORING
  INVESTMENT_ANALYSIS

  // ADMIN
  USERS
  ROLES
  PERMISSIONS
  SYSTEM_CONFIG
  AUDIT_LOGS
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  REJECT
  EXPORT
  IMPORT
}

enum LogOperation {
  CREATE
  READ
  UPDATE
  DELETE
}

enum LogCategory {
  WRITE
  READ
  SENSITIVE_READ
}

enum LogStatus {
  FAILED
  SUCCESS
}

model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  users     User[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("departments")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  users           User[]
  roleOverrides   RoleOverride[]
  rolePermissions RolePermission[]

  @@index([deletedAt])
  @@map("roles")
}

model RoleOverride {
  id          String    @id @default(uuid())
  role        Role      @relation(fields: [roleId], references: [id])
  roleId      String    @map("role_id")
  user        User      @relation("has_role_override", fields: [userId], references: [id])
  userId      String    @map("user_id")
  isGranted   Boolean   @default(true) @map("is_granted")
  expiresAt   DateTime? @map("expires_at")
  reason      String
  createdBy   User      @relation("created_role_override", fields: [createdById], references: [id])
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([userId, roleId])
  @@index([deletedAt])
  @@map("role_overrides")
}

model Permission {
  id                  String               @id @default(uuid())
  name                String               @unique
  code                String               @unique
  description         String?
  module              PermissionModule
  submodule           PermissionSubmodule  @map("submodule")
  action              PermissionAction
  isWildcard          Boolean              @default(false) @map("is_wildcard")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  implies             PermissionImplies[]  @relation("permission")
  impliedBy           PermissionImplies[]  @relation("implied_permission")
  permissionOverrides PermissionOverride[]
  rolePermissions     RolePermission[]

  @@index([deletedAt])
  @@map("permissions")
}

model PermissionImplies {
  id                  String     @id @default(uuid())
  permissionId        String     @map("permission_id")
  impliedPermissionId String     @map("implied_permission_id")
  permission          Permission @relation("permission", fields: [permissionId], references: [id])
  impliedPermission   Permission @relation("implied_permission", fields: [impliedPermissionId], references: [id])
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  @@unique([permissionId, impliedPermissionId])
  @@index([deletedAt])
  @@map("permission_implies")
}

model PermissionOverride {
  id           String     @id @default(uuid())
  user         User       @relation("has_permission_override", fields: [userId], references: [id])
  userId       String     @map("user_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String     @map("permission_id")
  createdBy    User       @relation("created_permission_override", fields: [createdById], references: [id])
  createdById  String     @map("created_by_id")
  isGranted    Boolean    @default(true) @map("is_granted")
  isTemporary  Boolean    @default(false) @map("is_temporary")
  expiresAt    DateTime?  @map("expires_at")
  reason       String
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  @@unique([userId, permissionId])
  @@index([deletedAt])
  @@map("permission_overrides")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       String     @map("role_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String     @map("permission_id")
  createdBy    User       @relation(fields: [createdById], references: [id])
  createdById  String     @map("created_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  @@unique([roleId, permissionId])
  @@index([deletedAt])
  @@map("role_permissions")
}

model User {
  id                          String               @id @default(uuid())
  email                       String               @unique
  username                    String               @unique
  name                        String
  surname                     String
  employeeId                  String               @unique @map("employee_id")
  nationalIdNumber            String               @unique @map("national_id_number")
  phoneNumber                 String?              @unique @map("phone_number")
  isEmailVerified             Boolean              @default(false) @map("is_email_verified")
  status                      Status               @default(ACTIVE)
  password                    String
  passwordConfirm             String?              @map("password_confirm")
  passwordChangedAt           DateTime?            @map("password_changed_at")
  deactivatedUntil            DateTime?            @map("deactivated_until")
  failedLoginAttempts         Int                  @default(0) @map("failed_login_attempts")
  lockedUntil                 DateTime?            @map("locked_until")
  lastLoggedInAt              DateTime?            @map("last_logged_in_at")
  dob                         DateTime?
  gender                      Gender               @default(M)
  profilePictureUrl           String?              @map("profile_picture_url")
  address                     String?
  emergencyContactName        String?              @map("emergency_contact_name")
  emergencyContactPhoneNumber String?              @map("emergency_contact_phone_number")
  hireDate                    DateTime             @map("hire_date")
  baseSalaryInCFA             Int?                 @map("base_salary_in_cfa")
  bankName                    String?              @map("bank_name")
  cnpsNumber                  String?              @map("cnps_number")
  taxId                       String?              @map("tax_id")
  department                  Department           @relation(fields: [departmentId], references: [id])
  departmentId                String               @map("department_id")
  role                        Role                 @relation(fields: [roleId], references: [id])
  roleId                      String               @map("role_id")
  createdAt                   DateTime             @default(now()) @map("created_at")
  updatedAt                   DateTime             @updatedAt @map("updated_at")
  deletedAt                   DateTime?            @map("deleted_at")
  preference                  UserPreference?
  roleOverrides               RoleOverride[]       @relation("has_role_override")
  createdRoleOverrides        RoleOverride[]       @relation("created_role_override")
  permissionOverrides         PermissionOverride[] @relation("has_permission_override")
  createdPermissionOverrides  PermissionOverride[] @relation("created_permission_override")
  createdRolePermissions      RolePermission[]
  activityLogs                ActivityLog[]

  @@index([deletedAt])
  @@map("users")
}

model UserPreference {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique @map("user_id")
  language  Language @default(FR)
  currency  Currency @default(FCFA)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

model ActivityLog {
  id            String       @id @default(uuid())
  user          User?        @relation(fields: [userId], references: [id])
  userId        String?      @map("user_id")
  userEmail     String       @map("user_email")
  operation     LogOperation
  category      LogCategory
  tableName     String       @map("table_name")
  recordId      String       @map("record_id")
  previousState Json?        @map("previous_state")
  newState      Json?        @map("new_state")
  changedFields String[]     @map("changed_fields")
  ipAddress     String?      @map("ip_address")
  userAgent     String?      @map("user_agent")
  requestId     String?      @map("request_id")
  metadata      Json?
  status        LogStatus
  failureReason String?      @map("failure_reason")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([userId])
  @@index([tableName])
  @@index([operation])
  @@index([createdAt])
  @@map("activity_logs")
}
