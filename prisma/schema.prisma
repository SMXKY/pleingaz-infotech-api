datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

//HR and Auth Module
enum Status {
  ACTIVE
  TERMINATED
  SUSPENDED
}

enum Gender {
  M
  F
}

enum Language {
  FR
  ENG
}

enum Currency {
  XAF
  EUR
  USD
}

enum PermissionRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PermissionModule {
  EXPLOITATION
  LOGISTICS
  SALES
  FILLING_PRODUCTION
  ACCOUNTING
  HUMAN_RESOURCES
  LEGAL
  MAINTENANCE_TECHNICAL
  RESEARCH_DEVELOPMENT
  ADMIN
  USER_MANAGEMENT
}

enum PermissionSubmodule {
  // EXPLOITATION
  GAS_ORDERS
  SUPPLIER_MANAGEMENT
  SAFETY_CAPS_JOINTS

  // LOGISTICS
  VEHICLE_INSPECTION
  FUEL_MANAGEMENT
  DRIVER_DOCUMENTS
  TRANSPORT_RECEIPTS
  POCKET_ALLOWANCE

  // SALES
  TRANSACTIONS
  WAREHOUSE_STOCK
  DISCOUNTS
  CASH_RECONCILIATION
  AGENCIES

  // FILLING_PRODUCTION
  TANK_MANAGEMENT
  BOTTLE_TRACKING
  PRODUCTION_RECORDS
  STOCK_RECONCILIATION

  // ACCOUNTING
  SUPPLIER_INVOICES
  CUSTOMER_INVOICES
  CASH_BANK
  PAYROLL
  FIXED_ASSETS
  TAX_DECLARATIONS
  FINANCIAL_REPORTS

  // HUMAN_RESOURCES
  ATTENDANCE
  RECRUITMENT
  SALARY_MANAGEMENT
  LEAVE_PERMISSION
  MISSIONS

  // LEGAL
  MAIL_MANAGEMENT
  INSURANCE
  ACCIDENTS
  DEBT_RECOVERY
  CONTRACTS
  COMPLAINTS
  CONVOCATIONS

  // MAINTENANCE_TECHNICAL
  FAULT_DECLARATION
  MAINTENANCE_WORKFLOW
  TECHNICIAN_ASSIGNMENT
  SPARE_PARTS
  MAINTENANCE_REPORTS

  // RESEARCH_DEVELOPMENT
  PROJECTS
  PROJECT_MONITORING
  INVESTMENT_ANALYSIS

  // ADMIN
  USERS
  ROLES
  PERMISSIONS
  SYSTEM_CONFIG
  AUDIT_LOGS
  DEPARTMENTS
  ADMINISTRATION
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  REJECT
  EXPORT
  IMPORT
  RESTORE
  ADMIN
}

enum LogOperation {
  CREATE
  READ
  UPDATE
  DELETE
  AUTH
  FORGOT_PASSWORD
  RESET_PASSWORD
  CHANGE_PASSWORD
  CHANGE_USER_CREDENTIALS
}

enum LogCategory {
  WRITE
  READ
  SENSITIVE_READ
}

enum LogStatus {
  FAILED
  SUCCESS
}

enum TokenType {
  PASSWORD_SETUP
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  users     User[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  isSystem  Boolean?  @map("is_system")

  @@index([deletedAt])
  @@map("departments")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  users           User[]
  roleOverrides   RoleOverride[]
  rolePermissions RolePermission[]
  isSystem        Boolean?         @map("is_system")

  @@index([deletedAt])
  @@map("roles")
}

model RoleOverride {
  id          String    @id @default(uuid())
  role        Role      @relation(fields: [roleId], references: [id])
  roleId      String    @map("role_id")
  user        User      @relation("has_role_override", fields: [userId], references: [id])
  userId      String    @map("user_id")
  isGranted   Boolean   @default(true) @map("is_granted")
  expiresAt   DateTime? @map("expires_at")
  reason      String
  createdBy   User      @relation("created_role_override", fields: [createdById], references: [id])
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([userId, roleId])
  @@index([deletedAt])
  @@map("role_overrides")
}

model Permission {
  id                  String               @id @default(uuid())
  engName             String               @unique
  frName              String               @unique
  code                String               @unique
  description         String?
  module              PermissionModule
  submodule           PermissionSubmodule  @map("submodule")
  action              PermissionAction
  isWildcard          Boolean              @default(false) @map("is_wildcard")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  implies             PermissionImplies[]  @relation("permission")
  impliedBy           PermissionImplies[]  @relation("implied_permission")
  permissionOverrides PermissionOverride[]
  rolePermissions     RolePermission[]
  riskLevel           PermissionRiskLevel  @default(LOW) @map("risk_level")

  @@index([deletedAt])
  @@map("permissions")
}

model PermissionImplies {
  id                  String     @id @default(uuid())
  permissionId        String     @map("permission_id")
  impliedPermissionId String     @map("implied_permission_id")
  permission          Permission @relation("permission", fields: [permissionId], references: [id])
  impliedPermission   Permission @relation("implied_permission", fields: [impliedPermissionId], references: [id])
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  @@unique([permissionId, impliedPermissionId])
  @@index([deletedAt])
  @@map("permission_implies")
}

model PermissionOverride {
  id           String     @id @default(uuid())
  user         User       @relation("has_permission_override", fields: [userId], references: [id])
  userId       String     @map("user_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String     @map("permission_id")
  createdBy    User       @relation("created_permission_override", fields: [createdById], references: [id])
  createdById  String     @map("created_by_id")
  isGranted    Boolean    @default(true) @map("is_granted")
  isTemporary  Boolean    @default(false) @map("is_temporary")
  expiresAt    DateTime?  @map("expires_at")
  reason       String
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  @@unique([userId, permissionId])
  @@index([deletedAt])
  @@map("permission_overrides")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role       @relation(fields: [roleId], references: [id])
  roleId       String     @map("role_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId String     @map("permission_id")
  createdBy    User       @relation(fields: [createdById], references: [id])
  createdById  String     @map("created_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  @@unique([roleId, permissionId])
  @@index([deletedAt])
  @@map("role_permissions")
}

model User {
  id                          String                   @id @default(uuid())
  email                       String                   @unique
  username                    String?                  @unique
  name                        String
  surname                     String
  employeeId                  String                   @unique @map("employee_id")
  nationalIdNumber            String                   @unique @map("national_id_number")
  phoneNumber                 String?                  @unique @map("phone_number")
  isEmailVerified             Boolean                  @default(false) @map("is_email_verified")
  status                      Status                   @default(ACTIVE)
  password                    String?
  passwordConfirm             String?                  @map("password_confirm")
  passwordChangedAt           DateTime?                @map("password_changed_at")
  deactivatedUntil            DateTime?                @map("deactivated_until")
  failedLoginAttempts         Int                      @default(0) @map("failed_login_attempts")
  lockedUntil                 DateTime?                @map("locked_until")
  lastLoggedInAt              DateTime?                @map("last_logged_in_at")
  dob                         DateTime?                @db.Date
  gender                      Gender                   @default(M)
  profilePictureUrl           String?                  @map("profile_picture_url")
  address                     String?
  emergencyContactName        String?                  @map("emergency_contact_name")
  emergencyContactPhoneNumber String?                  @map("emergency_contact_phone_number")
  hireDate                    DateTime                 @map("hire_date") @db.Date
  baseSalaryInCFA             Int?                     @map("base_salary_in_cfa")
  bankName                    String?                  @map("bank_name")
  cnpsNumber                  String?                  @map("cnps_number")
  taxId                       String?                  @map("tax_id")
  department                  Department               @relation(fields: [departmentId], references: [id])
  departmentId                String                   @map("department_id")
  role                        Role                     @relation(fields: [roleId], references: [id])
  roleId                      String                   @map("role_id")
  createdAt                   DateTime                 @default(now()) @map("created_at")
  updatedAt                   DateTime                 @updatedAt @map("updated_at")
  deletedAt                   DateTime?                @map("deleted_at")
  preference                  UserPreference?
  roleOverrides               RoleOverride[]           @relation("has_role_override")
  createdRoleOverrides        RoleOverride[]           @relation("created_role_override")
  permissionOverrides         PermissionOverride[]     @relation("has_permission_override")
  createdPermissionOverrides  PermissionOverride[]     @relation("created_permission_override")
  createdRolePermissions      RolePermission[]
  activityLogs                ActivityLog[]
  isSystem                    Boolean?                 @map("is_system")
  UserToken                   UserToken[]
  suspensionReason            String?                  @map("suspension_reason")
  createdInvoices             ExploitationInvoice[]    @relation("exploitation_invoices_created_by")
  paidInvoices                ExploitationInvoice[]    @relation("exploitation_invoices_paid_by")
  uploadedDocuments           ExploitationDocument[]   @relation("exploitation_documents_uploaded_by")
  gasPurchaseOrders           GasPurchaseOrder[]       @relation("gas_purchase_orders_created_by")
  gasBottlePurchaseOrders     GasBottlePurchaseOrder[] @relation("gas_bottle_purchase_orders_created_by")
  accessoryPurchaseOrders     AccessoryPurchaseOrder[] @relation("accessory_purchase_orders_created_by")
  approvalRequests            Approval[]               @relation("approval_requested_by")
  approvalStepsDecided        ApprovalStep[]           @relation("approval_step_decided_by")
  financeSettingsUpdates      FinanceSettings[]        @relation("finance_settings_updated_by")
  suppliersCreated            Supplier[]               @relation("supplier_created_by")
  drivers                     ExploitationDriver[]     @relation("driver_user")

  @@index([deletedAt])
  @@map("users")
}

model UserPreference {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique @map("user_id")
  language  Language @default(FR)
  currency  Currency @default(XAF)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}

model ActivityLog {
  id            String       @id @default(uuid())
  user          User?        @relation(fields: [userId], references: [id])
  userId        String?      @map("user_id")
  userEmail     String?      @map("user_email")
  operation     LogOperation
  category      LogCategory
  tableName     String       @map("table_name")
  recordId      String       @map("record_id")
  previousState Json?        @map("previous_state")
  newState      Json?        @map("new_state")
  changedFields String[]     @map("changed_fields")
  ipAddress     String?      @map("ip_address")
  userAgent     String?      @map("user_agent")
  requestId     String?      @map("request_id")
  metadata      Json?
  status        LogStatus
  failureReason String?      @map("failure_reason")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([userId])
  @@index([tableName])
  @@index([operation])
  @@index([createdAt])
  @@map("activity_logs")
}

model UserToken {
  id        String    @id
  user      User      @relation(fields: [userId], references: [id])
  userId    String    @map("user_id")
  type      TokenType
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([userId])
  @@index([type])
  @@map("user_tokens")
}

enum ConfigType {
  MAIN
}

model AdminConfig {
  id                 ConfigType @id @default(MAIN)
  companyEmail       String     @map("company_email")
  supportEmail       String     @map("support_email")
  companyPhoneNumber String     @map("company_phone_number")
  companyPrefix      String     @default("INF") @map("company_prefix")
  logoUrl            String?    @map("logo_url")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@map("admin_config")
}

// EXPLOITATION MODULE 

enum SupplierType {
  GAS
  ACCESSORIES
  BOTTLES
  MULTIPLE
}

enum SupplierCategory {
  LOCAL
  INTERNATIONAL
}

enum SupplierTier {
  STANDARD
  PREMIUM
}

enum PaymentMethod {
  BANK_TRANSFER
  MOBILE_MONEY
  CHECK
  CASH
}

enum MobileMoneyProvider {
  MTN_MOBILE_MONEY
  ORANGE_MONEY
}

enum SupplierAddressType {
  BILLING
  WAREHOUSE
  FACTORY
  PICKUP
}

enum DepotType {
  TERMINAL
  DEPOT
  WAREHOUSE
}

enum DepotCategory {
  PRIMARY_HUB
  INLAND_DISTRIBUTION
}

enum TankerStatus {
  AVAILABLE
  MAINTENANCE
  IN_TRANSIT
  LOADING
  IDLE
}

enum OrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  FINALIZED
  CONFIRMED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum OrderPriority {
  NORMAL
  URGENT
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum GasUnit {
  TONS
  LITERS
  KG
}

enum TransportMode {
  SEA_FREIGHT
  AIR_FREIGHT
  ROAD
}

enum GasBottleCategory {
  SMALL
  MEDIUM
  LARGE
}

enum GasBottleSize {
  G230
  G450
  KG6
  KG12_5
  KG50
}

enum ExploitationInvoiceType {
  GAS
  GAS_BOTTLE
  ACCESSORY
}

enum ExploitationInvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum ExploitationDocumentType {
  INVOICE
  RECEIPT
  CONFIRMATION
  SCREENSHOT
  OTHER
}

enum ApprovalEntityType {
  GAS_ORDER
  ACCESSORY_ORDER
  GAS_BOTTLE_ORDER
  VEHICLE_REPAIR
  SPARE_PARTS
  DISCOUNT_REQUEST
  PERMISSION
  MISSION
  SALARY_ADJUSTMENT
  RD_PROJECT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalRole {
  CEO
  ACCOUNTING
  CHIEF_EXPLOITATION
  DEPARTMENT_HEAD
  GENERAL_MANAGER
}

enum SequenceType {
  GAS_PO
  GAS_BOTTLE_PO
  ACCESSORY_PO
  GAS_INVOICE
  GAS_BOTTLE_INVOICE
  ACCESSORY_INVOICE
}

model FinanceSettings {
  id            ConfigType @id @default(MAIN)
  vatPct        Decimal    @map("vat_pct") @db.Decimal(5, 2)
  regulatoryTax Decimal    @map("regulatory_tax_pct") @db.Decimal(5, 2)
  updatedById   String?    @map("updated_by_id")
  updatedBy     User?      @relation("finance_settings_updated_by", fields: [updatedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("finance_settings")
}

model NumberSequence {
  id            String       @id @default(uuid())
  type          SequenceType @unique
  prefix        String
  currentYear   Int          @map("current_year")
  currentNumber Int          @default(0) @map("current_number")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("number_sequences")
}

model Supplier {
  id                String           @id @default(uuid())
  code              String           @unique
  name              String           @unique
  fullName          String?          @map("full_name")
  type              SupplierType
  category          SupplierCategory @default(LOCAL)
  tier              SupplierTier     @default(STANDARD)
  isPreferred       Boolean          @default(false) @map("is_preferred")
  isVerifiedPartner Boolean          @default(true) @map("is_verified_partner")
  isActive          Boolean          @default(true) @map("is_active")
  createdById       String           @map("created_by_id")
  createdBy         User             @relation("supplier_created_by", fields: [createdById], references: [id])

  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")
  deletedAt               DateTime?                   @map("deleted_at")
  paymentMethods          SupplierPaymentMethod[]     @relation("supplier_payment_methods")
  commercialTerms         SupplierCommercialTerms?    @relation("supplier_commercial_terms")
  addresses               SupplierAddress[]           @relation("supplier_addresses")
  contacts                SupplierContact[]           @relation("supplier_contacts")
  performanceMetrics      SupplierPerformanceMetrics?
  gasPurchaseOrders       GasPurchaseOrder[]
  gasBottlePurchaseOrders GasBottlePurchaseOrder[]
  accessoryPurchaseOrders AccessoryPurchaseOrder[]

  @@index([deletedAt])
  @@index([type])
  @@index([isActive])
  @@map("suppliers")
}

model SupplierPaymentMethod {
  id                  String               @id @default(uuid())
  supplier            Supplier             @relation("supplier_payment_methods", fields: [supplierId], references: [id])
  supplierId          String               @map("supplier_id")
  method              PaymentMethod
  label               String?
  currency            Currency
  bankName            String?              @map("bank_name")
  accountNumber       String?              @map("account_number")
  accountName         String?              @map("account_name")
  swiftBic            String?              @map("swift_bic")
  iban                String?
  mobileMoneyProvider MobileMoneyProvider? @map("mobile_money_provider")
  mobileMoneyNumber   String?              @map("mobile_money_number")
  mobileMoneyName     String?              @map("mobile_money_name")
  isDefault           Boolean              @default(false) @map("is_default")
  isActive            Boolean              @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([supplierId])
  @@index([deletedAt])
  @@map("supplier_payment_methods")
}

model SupplierCommercialTerms {
  id                 String    @id @default(uuid())
  supplier           Supplier  @relation("supplier_commercial_terms", fields: [supplierId], references: [id])
  supplierId         String    @unique @map("supplier_id")
  paymentTerms       String?   @map("payment_terms")
  paymentProcess     String?   @map("payment_process")
  minOrderQuantity   Decimal?  @map("min_order_quantity") @db.Decimal(10, 2)
  minOrderUnit       String?   @map("min_order_unit")
  defaultCurrency    Currency? @map("default_currency")
  creditLimit        Decimal?  @map("credit_limit") @db.Decimal(15, 2)
  agreedLeadTimeDays Int?      @map("agreed_lead_time_days")
  notes              String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("supplier_commercial_terms")
}

model SupplierAddress {
  id           String              @id @default(uuid())
  supplier     Supplier            @relation("supplier_addresses", fields: [supplierId], references: [id])
  supplierId   String              @map("supplier_id")
  addressType  SupplierAddressType @default(PICKUP) @map("address_type")
  label        String?
  addressLine1 String?             @map("address_line_1")
  addressLine2 String?             @map("address_line_2")
  city         String?
  region       String?
  country      String              @default("Cameroun")
  longitude    Decimal?            @db.Decimal(11, 8)
  latitude     Decimal?            @db.Decimal(10, 8)
  isDefault    Boolean             @default(false) @map("is_default")
  isActive     Boolean             @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([supplierId])
  @@index([deletedAt])
  @@map("supplier_addresses")
}

model SupplierContact {
  id          String   @id @default(uuid())
  supplier    Supplier @relation("supplier_contacts", fields: [supplierId], references: [id])
  supplierId  String   @map("supplier_id")
  name        String
  title       String?
  department  String?
  email       String?
  phoneNumber String?  @map("phone_number")
  isPrimary   Boolean  @default(false) @map("is_primary")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([supplierId])
  @@index([deletedAt])
  @@map("supplier_contacts")
}

model SupplierPerformanceMetrics {
  id                String    @id @default(uuid())
  supplier          Supplier  @relation(fields: [supplierId], references: [id])
  supplierId        String    @unique @map("supplier_id")
  rating            Decimal?  @db.Decimal(2, 1)
  totalOrders       Int       @default(0) @map("total_orders")
  completedOrders   Int       @default(0) @map("completed_orders")
  onTimeDeliveries  Int       @default(0) @map("on_time_deliveries")
  onTimeDeliveryPct Decimal   @default(0) @map("on_time_delivery_pct") @db.Decimal(5, 2)
  avgLeadTimeDays   Decimal?  @map("avg_lead_time_days") @db.Decimal(5, 1)
  totalSpendCfa     Decimal   @default(0) @map("total_spend_cfa") @db.Decimal(18, 2)
  lastOrderDate     DateTime? @map("last_order_date") @db.Date
  lastCalculatedAt  DateTime? @map("last_calculated_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("supplier_performance_metrics")
}

model ExploitationDepot {
  id                    String         @id @default(uuid())
  code                  String         @unique
  name                  String         @unique
  type                  DepotType      @default(WAREHOUSE)
  category              DepotCategory?
  description           String?
  addressLine1          String?        @map("address_line_1")
  addressLine2          String?        @map("address_line_2")
  city                  String?
  region                String?
  country               String         @default("Cameroun")
  longitude             Decimal?       @db.Decimal(11, 8)
  latitude              Decimal?       @db.Decimal(10, 8)
  contactName           String?        @map("contact_name")
  contactTitle          String?        @map("contact_title")
  contactPhoneNumber    String?        @map("contact_phone_number")
  contactEmail          String?        @map("contact_email")
  hasPortAccess         Boolean        @default(false) @map("has_port_access")
  storageCapacityTons   Decimal?       @map("storage_capacity_tons") @db.Decimal(10, 2)
  tankCount             Int?           @map("tank_count")
  supportedProductTypes String[]       @default([]) @map("supported_product_types")
  transitDaysFromMain   Int?           @default(0) @map("transit_days_from_main")
  isActive              Boolean        @default(true) @map("is_active")

  tankers                 Tanker[]                 @relation("depot_tankers")
  gasPurchaseOrders       GasPurchaseOrder[]
  gasBottlePurchaseOrders GasBottlePurchaseOrder[]
  accessoryPurchaseOrders AccessoryPurchaseOrder[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([type])
  @@index([isActive])
  @@index([deletedAt])
  @@map("exploitation_depots")
}

model ExploitationDriver {
  id                      String    @id @default(uuid())
  user                    User      @relation("driver_user", fields: [userId], references: [id])
  userId                  String    @unique @map("user_id")
  licenseNumber           String?   @unique @map("license_number")
  licenseType             String?   @map("license_type")
  licenseExpiryDate       DateTime? @map("license_expiry_date") @db.Date
  isCertified             Boolean   @default(false) @map("is_certified")
  certificationExpiryDate DateTime? @map("certification_expiry_date") @db.Date
  isActive                Boolean   @default(true) @map("is_active")

  tanker                  Tanker?
  gasPurchaseOrderTankers GasPurchaseOrderTanker[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([isActive])
  @@index([deletedAt])
  @@map("drivers")
}

model Tanker {
  id                      String             @id @default(uuid())
  code                    String             @unique
  model                   String?
  licensePlate            String             @unique @map("license_plate")
  type                    String?
  totalCapacityLiters     Decimal?           @map("total_capacity_liters") @db.Decimal(10, 2)
  totalCapacityTons       Decimal?           @map("total_capacity_tons") @db.Decimal(10, 2)
  safetyFactorPct         Decimal            @default(85.00) @map("safety_factor_pct") @db.Decimal(5, 2)
  currentLocation         String?            @map("current_location")
  depot                   ExploitationDepot? @relation("depot_tankers", fields: [depotId], references: [id])
  depotId                 String?            @map("depot_id")
  status                  TankerStatus       @default(IDLE)
  lastServicedAt          DateTime?          @map("last_serviced_at")
  nextServiceDueAt        DateTime?          @map("next_service_due_at") @db.Date
  driver                  ExploitationDriver @relation(fields: [driverId], references: [id])
  driverId                String             @unique @map("driver_id")
  isCertified             Boolean            @default(false) @map("is_certified")
  certificationExpiryDate DateTime?          @map("certification_expiry_date") @db.Date
  isActive                Boolean            @default(true) @map("is_active")

  gasPurchaseOrderTankers GasPurchaseOrderTanker[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status])
  @@index([depotId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("tankers")
}

model GasPurchaseOrder {
  id               String        @id @default(uuid())
  reference        String        @unique
  status           OrderStatus   @default(DRAFT)
  priority         OrderPriority @default(NORMAL)
  collectionDate   DateTime?     @map("collection_date") @db.Date
  arrivalDate      DateTime?     @map("arrival_date") @db.Date
  requestedDate    DateTime?     @map("requested_date") @db.Date
  paymentStatus    PaymentStatus @default(PENDING) @map("payment_status")
  notes            String?
  internalNotes    String?       @map("internal_notes")
  emailSentAt      DateTime?     @map("email_sent_at")
  currency         Currency      @default(XAF)
  vatPct           Decimal       @map("vat_pct") @db.Decimal(5, 2)
  regulatoryTaxPct Decimal       @map("regulatory_tax_pct") @db.Decimal(5, 2)
  subTotal         Decimal?      @db.Decimal(15, 2)
  vatAmount        Decimal?      @map("vat_amount") @db.Decimal(15, 2)
  regulatoryTaxAmt Decimal?      @map("regulatory_tax_amount") @db.Decimal(15, 2)
  total            Decimal?      @db.Decimal(15, 2)
  totalInCfa       Decimal?      @map("total_in_cfa") @db.Decimal(15, 2)

  supplier    Supplier?          @relation(fields: [supplierId], references: [id])
  supplierId  String?            @map("supplier_id")
  depot       ExploitationDepot? @relation(fields: [depotId], references: [id])
  depotId     String?            @map("depot_id")
  createdBy   User               @relation("gas_purchase_orders_created_by", fields: [createdById], references: [id])
  createdById String             @map("created_by_id")

  tankers   GasPurchaseOrderTanker[]
  lineItems GasPurchaseOrderItem[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status])
  @@index([supplierId])
  @@index([paymentStatus])
  @@index([createdById])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("gas_purchase_orders")
}

model GasPurchaseOrderTanker {
  id             String             @id @default(uuid())
  order          GasPurchaseOrder   @relation(fields: [orderId], references: [id])
  orderId        String             @map("order_id")
  tanker         Tanker             @relation(fields: [tankerId], references: [id])
  tankerId       String             @map("tanker_id")
  driver         ExploitationDriver @relation(fields: [driverId], references: [id])
  driverId       String             @map("driver_id")
  collectionDate DateTime?          @map("collection_date") @db.Date
  actualFillTons Decimal?           @map("actual_fill_tons") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([orderId, tankerId])
  @@index([orderId])
  @@index([tankerId])
  @@map("gas_purchase_order_tankers")
}

model GasPurchaseOrderItem {
  id          String           @id @default(uuid())
  order       GasPurchaseOrder @relation(fields: [orderId], references: [id])
  orderId     String           @map("order_id")
  code        String?
  name        String
  description String?
  grade       String?
  quantity    Decimal          @db.Decimal(10, 2)
  unit        GasUnit
  unitPrice   Decimal          @map("unit_price") @db.Decimal(15, 4)
  lineTotal   Decimal          @map("line_total") @db.Decimal(15, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("gas_purchase_order_items")
}

model GasBottleType {
  id                  String            @id @default(uuid())
  code                String            @unique
  name                String?
  capacityGrams       Int               @map("capacity_grams")
  capacityKg          Decimal           @map("capacity_kg") @db.Decimal(5, 2)
  size                GasBottleSize
  category            GasBottleCategory
  accessoryCategory   AccessoryCategory @relation(fields: [accessoryCategoryId], references: [id])
  accessoryCategoryId String            @map("accessory_category_id")
  description         String?
  isActive            Boolean           @default(true) @map("is_active")

  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  deletedAt                   DateTime?                    @map("deleted_at")
  gasBottlePurchaseOrderItems GasBottlePurchaseOrderItem[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("gas_bottle_types")
}

model GasBottlePurchaseOrder {
  id                    String        @id @default(uuid())
  reference             String        @unique
  status                OrderStatus   @default(DRAFT)
  requestedDeliveryDate DateTime?     @map("requested_delivery_date") @db.Date
  actualDeliveryDate    DateTime?     @map("actual_delivery_date") @db.Date
  paymentStatus         PaymentStatus @default(PENDING) @map("payment_status")
  notes                 String?
  internalNotes         String?       @map("internal_notes")
  emailSentAt           DateTime?     @map("email_sent_at")
  currency              Currency      @default(XAF)
  vatPct                Decimal       @map("vat_pct") @db.Decimal(5, 2)
  subTotal              Decimal?      @db.Decimal(15, 2)
  vatAmount             Decimal?      @map("vat_amount") @db.Decimal(15, 2)
  shippingCost          Decimal?      @default(0) @map("shipping_cost") @db.Decimal(15, 2)
  total                 Decimal?      @db.Decimal(15, 2)

  supplier    Supplier          @relation(fields: [supplierId], references: [id])
