# --- Server ---
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DEV_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
TEMP_DIR=./tmp
DEV_UPLOAD_DIR=./uploads

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pleingaz

# --- Auth ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
PASSWORD_RESET_EXPIRES_IN=15
EMAIL_VERIFICATION_EXPIRES_IN=60
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOGIN_WAIT_TIME_HOURS=1
RESET_PASSWORD_LIMIT_HOURS=1

# --- Seeded accounts ---
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_FIRST_NAME=System
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_USERNAME=sysadmin
# Optional test accounts (skipped if unset)
CEO_EMAIL=
CEO_PASSWORD=
CEO_FIRST_NAME=
CEO_LAST_NAME=
CEO_USERNAME=

# --- Company ---
COMPANY_PREFIX=PLG
COMPANY_EMAIL=admin@example.com
COMPANY_PHONE=
SUPPORT_EMAIL=support@example.com

# --- Email ---
BREVO_API_KEY=
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=

# --- File storage (FTP) ---
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_UPLOAD_DIR=/uploads
FTP_BASE_URL=

# --- Firebase Cloud Messaging ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Exchange rates ---
UNIRATEAPI_KEY=

# --- Socket.IO ---
SOCKET_IO_PATH=/socket.io
SOCKET_IO_CORS_ORIGIN=http://localhost:5173

# --- Background jobs / notifications ---
JOB_BATCH_SIZE=100
MAX_BATCH_SIZE=500
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_URGENT_ESCALATION_MINUTES=10
STALE_TOKEN_DAYS=60
